#!/bin/sh
# initramfs-tools hook for Debian (newminhh)
PREREQ=""

prereqs() {
    echo "$PREREQ"
}

case "$1" in
    prereqs)
        prereqs
        exit 0
        ;;
esac

. /usr/share/initramfs-tools/hook-functions

if [ -x /usr/bin/newminhh-run ]; then
    copy_exec /usr/bin/newminhh-run /usr/bin
fi
if [ -x /usr/bin/newminhh ]; then
    copy_exec /usr/bin/newminhh /usr/bin
fi

# Copy libraries
for lib in /usr/lib/x86_64-linux-gnux32/libnewminhh_*.so /usr/libx32/libnewminhh_*.so; do
    if [ -e "$lib" ]; then
        copy_exec "$lib"
    fi
done

# Copy pattern file
for p in /usr/lib/binfmt.d/newminhh.conf /usr/share/newminhh/newminhh-binfmt.pattern; do
    if [ -f "$p" ]; then
        copy_file config "$p" "$p"
    fi
done

exit 0
