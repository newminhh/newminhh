#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- build

override_dh_auto_install:
	dh_auto_install -- install PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) BINDIR=/usr/bin
	# Install shared binfmt pattern and systemd config
	install -D -m 0644 distribution/common/newminhh-binfmt.pattern debian/newminhh/usr/share/newminhh/newminhh-binfmt.pattern
	install -D -m 0644 distribution/common/newminhh-binfmt.pattern debian/newminhh/usr/lib/binfmt.d/newminhh.conf
	# Install initramfs-tools hook and init-bottom script
	install -D -m 0755 distribution/init-tools/initramfs-tools/hook_newminhh debian/newminhh/usr/share/initramfs-tools/hooks/newminhh
	install -D -m 0755 distribution/init-tools/initramfs-tools/script_newminhh debian/newminhh/usr/share/initramfs-tools/scripts/init-bottom/newminhh
	# Install helper
	install -D -m 0755 distribution/service/binfmt-helper.sh debian/newminhh/usr/libexec/newminhh/binfmt-helper.sh
	install -D -m 0644 src/lookup/newminhh-lookup.path debian/newminhh/usr/lib/systemd/system/newminhh-lookup.path
	install -D -m 0644 src/lookup/newminhh-lookup.service debian/newminhh/usr/lib/systemd/system/newminhh-lookup.service
