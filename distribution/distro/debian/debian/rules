#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_build:
	dh_auto_build -- build

override_dh_auto_install:
	dh_auto_install -- install PREFIX=/usr LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH) BINDIR=/usr/bin
	# Install binfmt configuration for systemd
	install -D -m 0644 distribution/service/systemd/newminhh.conf debian/newminhh/usr/lib/binfmt.d/newminhh.conf
	# Install initramfs-tools hook and init-bottom script
	install -D -m 0755 distribution/init-tools/initramfs-tools/hook_newminhh debian/newminhh/usr/share/initramfs-tools/hooks/newminhh
	install -D -m 0755 distribution/init-tools/initramfs-tools/script_newminhh debian/newminhh/usr/share/initramfs-tools/scripts/init-bottom/newminhh
	# Install helper
	install -D -m 0755 distribution/service/binfmt-helper.sh debian/newminhh/usr/libexec/newminhh/binfmt-helper.sh
