#!/sbin/openrc-run
description="Register newminhh i386 binfmt_misc handler"

depend() {
    need localmount
    after bootmisc
    before sysinit
}

start() {
    ebegin "Registering newminhh-i386 in binfmt_misc"
    if [ -x /usr/libexec/newminhh/binfmt-helper.sh ]; then
        /usr/libexec/newminhh/binfmt-helper.sh start
    elif [ -x /usr/share/newminhh/binfmt-helper.sh ]; then
        /usr/share/newminhh/binfmt-helper.sh start
    else
        [ -d /proc/sys/fs/binfmt_misc ] || mkdir -p /proc/sys/fs/binfmt_misc
        grep -qs "binfmt_misc /proc/sys/fs/binfmt_misc" /proc/mounts || mount -t binfmt_misc binfmt_misc /proc/sys/fs/binfmt_misc 2>/dev/null || true
        if [ -f /proc/sys/fs/binfmt_misc/newminhh-i386 ]; then
            echo -1 > /proc/sys/fs/binfmt_misc/newminhh-i386 2>/dev/null || true
        fi
        for p in /usr/lib/binfmt.d/newminhh.conf /etc/binfmt.d/newminhh.conf /usr/share/newminhh/newminhh-binfmt.pattern; do
            if [ -f "$p" ]; then
                cat "$p" > /proc/sys/fs/binfmt_misc/register
                break
            fi
        done
    fi
    eend $?
}

stop() {
    ebegin "Unregistering newminhh-i386 from binfmt_misc"
    if [ -x /usr/libexec/newminhh/binfmt-helper.sh ]; then
        /usr/libexec/newminhh/binfmt-helper.sh stop
    elif [ -f /proc/sys/fs/binfmt_misc/newminhh-i386 ]; then
        echo -1 > /proc/sys/fs/binfmt_misc/newminhh-i386 2>/dev/null || true
    fi
    eend $?
}
