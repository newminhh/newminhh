[Unit]
Description=Register newminhh i386 binfmt_misc handler
Documentation=https://github.com/newminhh/newminhh
DefaultDependencies=no
After=proc-sys-fs-binfmt_misc.mount
Before=sysinit.target
ConditionPathIsReadWrite=/proc/sys/fs/binfmt_misc/register

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'if [ -x /usr/libexec/newminhh/binfmt-helper.sh ]; then exec /usr/libexec/newminhh/binfmt-helper.sh start; fi; if [ -f /proc/sys/fs/binfmt_misc/newminhh-i386 ]; then echo -1 > /proc/sys/fs/binfmt_misc/newminhh-i386; fi; cat /usr/lib/binfmt.d/newminhh.conf > /proc/sys/fs/binfmt_misc/register'
ExecStop=/bin/sh -c 'if [ -x /usr/libexec/newminhh/binfmt-helper.sh ]; then exec /usr/libexec/newminhh/binfmt-helper.sh stop; fi; if [ -f /proc/sys/fs/binfmt_misc/newminhh-i386 ]; then echo -1 > /proc/sys/fs/binfmt_misc/newminhh-i386; fi'

[Install]
WantedBy=sysinit.target
